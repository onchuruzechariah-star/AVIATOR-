import random
import time

def generate_crash_multiplier():
    """
    Simulates the mathematical logic behind a crash game.
    A small percentage of the time (e.g., 3%), the game crashes instantly at 1.00x.
    Otherwise, it generates a multiplier using an inverse uniform distribution.
    """
    # Instant crash house edge simulation
    if random.random() < 0.03:
        return 1.00
    
    # Generate the multiplier
    return round(1.01 / (1.0 - random.random()), 2)

def simulate_betting_strategy(starting_balance, bet_amount, auto_cashout, total_rounds):
    balance = starting_balance
    wins = 0
    losses = 0
    
    print(f"Starting Simulation with Base Balance: {balance} UGX/KES")
    print(f"Strategy: Auto-cashout at {auto_cashout}x | Bet: {bet_amount} per round\n")
    
    for r in range(1, total_rounds + 1):
        if balance < bet_amount:
            print(f"❌ Bankrupt at round {r}!")
            break
            
        balance -= bet_amount
        actual_crash = generate_crash_multiplier()
        
        if actual_crash >= auto_cashout:
            # Won the bet
            winnings = bet_amount * auto_cashout
            balance += winnings
            wins += 1
        else:
            # Lost the bet
            losses += 1
            
    print("-" * 40)
    print(f"Simulation Finished after {r} rounds.")
    print(f"Final Balance: {round(balance, 2)}")
    print(f"Total Wins: {wins} | Total Losses: {losses}")
    print(f"Win Rate: {round((wins / r) * 100, 2)}%")

# Run the simulation: 10,000 balance, 500 bet, auto-cashing at 1.50x multiplier for 100 rounds
simulate_betting_strategy(starting_balance=10000, bet_amount=500, auto_cashout=1.50, total_rounds=100)
